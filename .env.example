# ====================================================================
# METRO PROBATI (মেট্রো প্রভাতী) TRANSIT PLATFORM — ENVIRONMENT CONFIG
# ====================================================================

# 1. Supabase Configuration (PostgreSQL, Auth, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Google Maps Platform JavaScript API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...your-google-maps-api-key

# 3. Verified Helplines & Support
NEXT_PUBLIC_HELPLINE_PRIMARY=01798542469
NEXT_PUBLIC_HELPLINE_SECONDARY=01918695599
NEXT_PUBLIC_HELPLINE_WHATSAPP=01798542469

# 4. Mobile Digital Wallets (Sandbox / Production Gateway Credentials)
BKASH_CHECKOUT_APP_KEY=your-bkash-app-key
BKASH_CHECKOUT_APP_SECRET=your-bkash-app-secret
BKASH_CHECKOUT_USERNAME=your-bkash-username
BKASH_CHECKOUT_PASSWORD=your-bkash-password
BKASH_IS_SANDBOX=true

NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAD_PUBLIC_KEY=your-nagad-public-key
NAGAD_PRIVATE_KEY=your-nagad-private-key
NAGAD_IS_SANDBOX=true

ROCKET_MERCHANT_ID=your-rocket-merchant-id
ROCKET_SECRET_KEY=your-rocket-secret-key
ROCKET_IS_SANDBOX=true
